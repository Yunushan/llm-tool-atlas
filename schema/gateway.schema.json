{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Yunushan/llm-tool-atlas/main/schema/gateway.schema.json",
  "title": "LLM Tool Atlas gateway catalog",
  "type": "array",
  "minItems": 1,
  "uniqueItems": true,
  "items": {
    "type": "object",
    "required": [
      "id", "name", "vendor", "kind", "delivery", "byok", "self_host",
      "open_source", "pricing_note", "strengths", "limitations",
      "official_sources", "last_verified"
    ],
    "properties": {
      "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
      "name": {"type": "string", "minLength": 1, "pattern": "\\S"},
      "vendor": {"type": "string", "minLength": 1, "pattern": "\\S"},
      "kind": {"enum": ["model-marketplace", "api-gateway", "inference-platform", "cloud-model-platform"]},
      "delivery": {"enum": ["managed", "self-hosted", "managed-and-self-hosted"]},
      "byok": {"type": "boolean"},
      "self_host": {"type": "boolean"},
      "open_source": {"type": "boolean"},
      "license": {"type": ["string", "null"], "minLength": 1, "pattern": "\\S"},
      "pricing_note": {"type": "string", "minLength": 1, "pattern": "\\S"},
      "strengths": {
        "type": "array",
        "items": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "minItems": 1,
        "uniqueItems": true
      },
      "limitations": {
        "type": "array",
        "items": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "minItems": 1,
        "uniqueItems": true
      },
      "official_sources": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["label", "url"],
          "properties": {
            "label": {"type": "string", "minLength": 1, "pattern": "\\S"},
            "url": {"type": "string", "format": "uri", "pattern": "^https://"}
          },
          "additionalProperties": false
        },
        "minItems": 1,
        "uniqueItems": true
      },
      "last_verified": {
        "type": "string",
        "format": "date",
        "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
      }
    },
    "additionalProperties": false
  }
}
