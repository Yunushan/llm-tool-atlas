{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Yunushan/llm-tool-atlas/schema/model-family.schema.json",
  "title": "LLM Tool Atlas model-family record",
  "type": "object",
  "required": [
    "id", "provider", "family", "representative_models", "access",
    "open_weights", "modalities", "coding_notes", "limitations",
    "official_sources", "last_verified"
  ],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "provider": {"type": "string"},
    "family": {"type": "string"},
    "representative_models": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "access": {"type": "array", "items": {"enum": ["first-party-api", "cloud-platform", "gateway", "download"]}, "minItems": 1},
    "open_weights": {"type": "boolean"},
    "weight_license": {"type": ["string", "null"]},
    "modalities": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "context_note": {"type": ["string", "null"]},
    "api_pricing": {
      "type": ["object", "null"],
      "properties": {
        "input_usd_per_million": {"type": ["number", "null"], "minimum": 0},
        "cached_input_usd_per_million": {"type": ["number", "null"], "minimum": 0},
        "output_usd_per_million": {"type": ["number", "null"], "minimum": 0},
        "model": {"type": "string"},
        "note": {"type": "string"}
      },
      "required": ["input_usd_per_million", "cached_input_usd_per_million", "output_usd_per_million", "model", "note"],
      "additionalProperties": false
    },
    "coding_notes": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "limitations": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "official_sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["label", "url"],
        "properties": {"label": {"type": "string"}, "url": {"type": "string", "pattern": "^https://"}},
        "additionalProperties": false
      },
      "minItems": 1
    },
    "last_verified": {"type": "string", "format": "date"}
  },
  "additionalProperties": false
}
