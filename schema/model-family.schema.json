{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Yunushan/llm-tool-atlas/main/schema/model-family.schema.json",
  "title": "LLM Tool Atlas model-family catalog",
  "type": "array",
  "minItems": 1,
  "uniqueItems": true,
  "items": {
    "type": "object",
    "required": [
      "id", "provider", "family", "representative_models", "access",
      "open_weights", "input_modalities", "output_modalities", "capabilities",
      "coding_notes", "limitations",
      "official_sources", "last_verified"
    ],
    "properties": {
      "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
      "provider": {"type": "string", "minLength": 1, "pattern": "\\S"},
      "family": {"type": "string", "minLength": 1, "pattern": "\\S"},
      "representative_models": {
        "type": "array",
        "items": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "minItems": 1,
        "uniqueItems": true
      },
      "access": {
        "type": "array",
        "items": {"enum": ["first-party-api", "cloud-platform", "gateway", "download"]},
        "minItems": 1,
        "uniqueItems": true
      },
      "open_weights": {"type": "boolean"},
      "weight_license": {"type": ["string", "null"], "minLength": 1, "pattern": "\\S"},
      "input_modalities": {
        "type": "array",
        "items": {"enum": ["text", "image", "video", "audio", "document"]},
        "minItems": 1,
        "uniqueItems": true
      },
      "output_modalities": {
        "type": "array",
        "items": {"enum": ["text", "image", "audio", "video"]},
        "minItems": 1,
        "uniqueItems": true
      },
      "capabilities": {
        "type": "array",
        "items": {"enum": ["code-generation", "computer-use"]},
        "minItems": 1,
        "uniqueItems": true,
        "contains": {"const": "code-generation"}
      },
      "context_note": {"type": ["string", "null"], "minLength": 1, "pattern": "\\S"},
      "api_pricing": {
        "type": ["object", "null"],
        "properties": {
          "input_usd_per_million": {"type": ["number", "null"], "minimum": 0, "maximum": 1000000000},
          "cached_input_usd_per_million": {"type": ["number", "null"], "minimum": 0, "maximum": 1000000000},
          "output_usd_per_million": {"type": ["number", "null"], "minimum": 0, "maximum": 1000000000},
          "model": {"type": "string", "minLength": 1, "pattern": "\\S"},
          "note": {"type": "string", "minLength": 1, "pattern": "\\S"}
        },
        "required": ["input_usd_per_million", "cached_input_usd_per_million", "output_usd_per_million", "model", "note"],
        "additionalProperties": false
      },
      "coding_notes": {
        "type": "array",
        "items": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "minItems": 1,
        "uniqueItems": true
      },
      "limitations": {
        "type": "array",
        "items": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "minItems": 1,
        "uniqueItems": true
      },
      "official_sources": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["label", "url"],
          "properties": {
            "label": {"type": "string", "minLength": 1, "pattern": "\\S"},
            "url": {"type": "string", "format": "uri", "pattern": "^https://"}
          },
          "additionalProperties": false
        },
        "minItems": 1,
        "uniqueItems": true
      },
      "last_verified": {
        "type": "string",
        "format": "date",
        "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
      }
    },
    "additionalProperties": false
  }
}
